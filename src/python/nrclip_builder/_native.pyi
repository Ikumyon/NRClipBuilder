"""Required Rust extension; no Python fallback implementation."""
__version__: str

class CancelToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    def check(self) -> None: ...

class Selection:
    @property
    def count(self) -> int: ...
    def fields(self) -> list[str]: ...
    def select(self, options: str, token: CancelToken) -> Selection: ...
    def page(self, offset: int, limit: int) -> str: ...
    def geojson(self, token: CancelToken) -> str: ...
    def clipped_geojson(self, bbox: list[float], token: CancelToken) -> str: ...
    def export(self, format: str, options: str, token: CancelToken) -> bytes: ...

class Engine:
    def __init__(self) -> None: ...
    def register(self, id: str, features: str, token: CancelToken) -> None: ...
    def remove(self, id: str) -> None: ...
    def snapshot(self, id: str) -> str: ...
    def fields(self, id: str) -> list[str]: ...
    def capture(self, id: str) -> Selection: ...
    def edit_many(self, id: str, features: str, token: CancelToken) -> str: ...
    def feature(self, id: str, feature_id: str) -> str: ...
    def select(self, id: str, options: str, token: CancelToken) -> Selection: ...

def data_directory() -> str: ...
def system_locale() -> str: ...
def initialize() -> None: ...
def atomic_write(path: str, data: bytes) -> None: ...
def open_external(target: str) -> None: ...
def validate_bbox(bbox: list[float]) -> None: ...
def bundle_library(name: str) -> bool: ...
